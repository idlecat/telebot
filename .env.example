# Token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated Telegram numeric user IDs allowed to trigger the command.
# Get your own ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=111111111

# Command to run for every allowed message. The message text is appended as
# the final argument, e.g. with COMMAND=/scripts/handle.sh a message "status"
# runs: /scripts/handle.sh status
# No shell is invoked, so shell metacharacters in the message are NOT
# interpreted -- they arrive as a single literal argument.
COMMAND=/scripts/handle.sh

# Optional tuning (defaults shown)
# COMMAND_TIMEOUT=60 (raise this a lot, e.g. 1800, if COMMAND does long
# things like video downloads -- the command is killed if it runs longer)
# STARTUP_GRACE_PERIOD=60
# POLL_TIMEOUT=30
# LOG_LEVEL=INFO

# Free key from https://acoustid.org/api-key. Used by
# scripts/backfill_metadata.py to identify downloaded audio (via Chromaprint
# fingerprint + MusicBrainz lookup) and tag it with real artist/title/album.
# Downloads are left untagged (with a note in the reply) if this is unset.
ACOUSTID_API_KEY=
